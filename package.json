{
	"name": "the-ancient-mariner",
	"version": "1.0.0",
	"description": "A pi package",
	"keywords": ["pi-package"],
	"license": "ISC",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"format": "biome format . --write",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"typescript": "^5.8.3"
	},
	"pi": {
		"extensions": ["./extensions"],
		"skills": ["./skills"],
		"prompts": ["./prompts"],
		"themes": ["./themes"]
	},
	"lint-staged": {
		"*.{js,ts,json,md}": "biome check --write --no-errors-on-unmatched"
	},
	"dependencies": {
		"better-sqlite3": "^12.10.0",
		"effect": "^3.21.2"
	}
}
